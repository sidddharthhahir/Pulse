# Runtime data — your run history, drafts, schedule, and usage stats.
# Personal to your machine; a fresh clone starts with none of this.
pipeline_state/

# Your personal setup facts (name, email, resume, LinkedIn URL) — used once
# to bootstrap the Knowledge page, never meant to be shared or committed.
HANDOFF_PROMPT.md

# Your real identity/voice, not something to commit. profile.md and
# writing_samples.md are seeded from the tracked *.example.md templates on
# first read (see dashboard/lib/knowledge-base.ts) — edit the real files
# from the Knowledge page afterward; only the templates stay in git.
knowledge_base/profile.md
knowledge_base/writing_samples.md
knowledge_base/strategy_log.md
